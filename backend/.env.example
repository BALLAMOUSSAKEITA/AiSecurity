# Clé API Plate Recognizer (optionnelle mais recommandée pour une bonne précision)
# Obtenez une clé gratuite sur https://platerecognizer.com
PLATE_RECOGNIZER_API_KEY=

# Optionnel : chemin vers le binaire Tesseract si non dans le PATH
# Windows exemple : C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=
